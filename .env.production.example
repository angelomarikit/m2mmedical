# Copy to .env.production on the BUILD MACHINE ONLY (cPanel repo clone — NOT public_html).
# Used at `npm run build` so Vite can embed public Supabase keys into the JS bundle.
# Never commit .env.production. Never copy any .env* into public_html.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Do NOT set SUPABASE_SERVICE_ROLE_KEY here for production static deploy.
# Service role is for local scripts / Supabase Edge Functions on Supabase's servers only.
