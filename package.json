{
  "name": "m2m-medical",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:scan": "tsx scripts/assets-scan.ts",
    "assets:import": "tsx scripts/assets-import.ts",
    "logo:transparent": "tsx scripts/make-logo-transparent.ts",
    "catalog:sync": "tsx scripts/sync-catalog-assets.ts",
    "catalog:upload": "tsx scripts/upload-catalog.ts",
    "catalog:publish": "npm run catalog:sync && npm run catalog:upload && npm run db:seed",
    "db:seed": "tsx scripts/db-seed.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "storage:ensure": "tsx scripts/ensure-storage-buckets.ts",
    "prerender:routes": "tsx scripts/fetch-prerender-routes.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@hookform/resolvers": "^5.0.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.12.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.6.1",
